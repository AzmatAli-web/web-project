PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/campus_marketplace
JWT_SECRET=replace-with-a-long-random-value
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EMAIL_USER=
EMAIL_PASSWORD=
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=pkr
# On a long-running host, set an absolute directory on a persistent disk.
# UPLOAD_DIR=/var/data/campus-uploads

# Vercel uses MongoDB GridFS automatically for durable images.
# Set this locally to use the same storage mode:
# UPLOAD_STORAGE=mongodb
